# Supabase project (public values, safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Model provider. With GROQ_API_KEY set the agents run on Groq; without it they use Vercel AI Gateway.
GROQ_API_KEY=

# Optional: comma-separated model ids tried in order (overrides the defaults in lib/agents.js)
AGENT_MODEL=

# Optional: agent runs allowed per workspace per day (default 300)
DAILY_AGENT_RUNS=
